MEMGRAPH_HOST=memgraph-db
MEMGRAPH_PORT=7687
MEMGRAPH_USER=admin
MEMGRAPH_PASSWORD=twoje_haslo
# Konto administratora zakładane przy pierwszym starcie, jeśli w bazie nie ma
# jeszcze żadnego aktywnego admina. Zmień hasło po pierwszym zalogowaniu.
ADMIN_EMAIL=admin@smartrailway.pl
ADMIN_PASSWORD=admin12345
# Sekret podpisujący tokeny sesji — ustaw własny w produkcji.
# AUTH_SECRET=zmien-ten-sekret
# Adres backendu widziany przez przeglądarkę (WebSocket + polling).
PUBLIC_API_BASE_URL=http://localhost:8000
# Adres backendu widziany przez frontend podczas SSR.
# Lokalnie (bez Dockera) zostaw pusty — użyty będzie PUBLIC_API_BASE_URL.
# W Dockerze compose.yaml ustawia go na http://backend:8000.
# API_INTERNAL_URL=http://backend:8000
